PORT=8009
NODE_ENV=development

# New database for this service (not shared with smatpay_whatsapp_api).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smatpay_whatsapp
DB_USERNAME=root
DB_PASSWORD=

# 360dialog
D360_API_KEY=
D360_BASE_URL=https://waba-v2.360dialog.io
# Optional: when set, the webhook only accepts requests carrying this value in the
# X-Webhook-Secret header (configure the same header on the 360dialog webhook).
WEBHOOK_SECRET=

# Smatpay API gateway, no trailing slash.
SMATPAY_API_URL=https://dev.smatpay.africa:8443
# production: real payments. sandbox: simulated payment outcomes for testing (the app's plane switch).
SMATPAY_PLANE=production

# 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
# Encrypts the Smatpay tokens at rest. Changing it signs everyone out.
TOKEN_ENCRYPTION_KEY=

# WhatsApp Flows. IDs come from WhatsApp Manager once each flow in flows/ is published.
FLOW_SIGNUP_ID=
FLOW_LOGIN_ID=
FLOW_PIN_ID=
# "draft" lets you test unpublished flows; "published" for real users.
FLOW_MODE=draft
# The private key made by `npm run flow:keys`; its public half is uploaded to WhatsApp.
FLOW_PRIVATE_KEY_PATH=keys/flow_private.pem
FLOW_PRIVATE_KEY_PASSPHRASE=

SUPPORT_PHONE=+263000000000

# Sessions of users who haven't messaged for this many days are left to expire.
SESSION_KEEPALIVE_DAYS=90

# Public HTTPS address of this service (the ngrok domain locally); form links point here.
PUBLIC_URL=

# web: forms are pages on this server, opened from a button. flows: WhatsApp Flows (needs Meta to allow them).
FORMS_MODE=web

# Only these numbers (comma separated) are served; others are told they're not authorised. Empty = everyone.
ALLOWED_NUMBERS=
