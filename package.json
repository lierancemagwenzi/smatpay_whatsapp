{
  "name": "smatpay_whatsapp",
  "version": "1.0.0",
  "description": "SmatPay customer app on WhatsApp, via 360dialog",
  "main": "app.js",
  "private": true,
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "node --test test/*.test.js",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "flow:keys": "node scripts/generate-flow-keys.js",
    "flow:upload-key": "node scripts/upload-flow-public-key.js",
    "flow:setup": "node scripts/setup-flows.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "morgan": "^1.10.1",
    "mysql2": "^3.15.3",
    "node-schedule": "^2.1.1",
    "pngjs": "^7.0.0",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "qrcode": "^1.5.4",
    "sequelize-cli": "^6.6.3"
  }
}
