{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "CONTACT": []
  },
  "screens": [
    {
      "id": "CONTACT",
      "title": "Contact person",
      "terminal": true,
      "success": true,
      "data": {
        "titles": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "title": {"type": "string"}}}, "__example__": [{"id": "1", "title": "Mr"}]},
        "title": {"type": "string", "__example__": ""},
        "first_name": {"type": "string", "__example__": ""},
        "last_name": {"type": "string", "__example__": ""},
        "id_number": {"type": "string", "__example__": ""},
        "email": {"type": "string", "__example__": ""},
        "mobile": {"type": "string", "__example__": ""},
        "has_error": {"type": "boolean", "__example__": false},
        "error_message": {"type": "string", "__example__": ""}
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {"type": "TextBody", "text": "${data.error_message}", "visible": "${data.has_error}"},
          {"type": "TextBody", "text": "The person Smatpay contacts about the company’s account, usually a director."},
          {"type": "Dropdown", "name": "title", "label": "Title", "required": true, "data-source": "${data.titles}", "init-value": "${data.title}"},
          {"type": "TextInput", "name": "first_name", "label": "First name", "input-type": "text", "required": true, "init-value": "${data.first_name}"},
          {"type": "TextInput", "name": "last_name", "label": "Last name", "input-type": "text", "required": true, "init-value": "${data.last_name}"},
          {"type": "TextInput", "name": "id_number", "label": "ID number", "input-type": "text", "required": true, "init-value": "${data.id_number}"},
          {"type": "TextInput", "name": "email", "label": "Email", "input-type": "email", "required": true, "init-value": "${data.email}"},
          {"type": "TextInput", "name": "mobile", "label": "Mobile number", "input-type": "phone", "required": true, "init-value": "${data.mobile}"},
          {
            "type": "Footer",
            "label": "Save contact",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {"title": "${form.title}", "first_name": "${form.first_name}", "last_name": "${form.last_name}", "id_number": "${form.id_number}", "email": "${form.email}", "mobile": "${form.mobile}"}
            }
          }
        ]
      }
    }
  ]
}
