{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "BANK": []
  },
  "screens": [
    {
      "id": "BANK",
      "title": "Your bank account",
      "terminal": true,
      "success": true,
      "data": {
        "banks": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "title": {"type": "string"}}}, "__example__": [{"id": "3", "title": "POSB"}]},
        "currencies": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "title": {"type": "string"}}}, "__example__": [{"id": "USD", "title": "USD"}]},
        "bank": {"type": "string", "__example__": ""},
        "branch": {"type": "string", "__example__": ""},
        "account_number": {"type": "string", "__example__": ""},
        "account_name": {"type": "string", "__example__": ""},
        "currency": {"type": "string", "__example__": "USD"},
        "has_error": {"type": "boolean", "__example__": false},
        "error_message": {"type": "string", "__example__": ""}
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {"type": "TextBody", "text": "${data.error_message}", "visible": "${data.has_error}"},
          {"type": "TextBody", "text": "Where Smatpay pays out your money. It must be in the business’s (or your) name."},
          {"type": "Dropdown", "name": "bank", "label": "Bank", "required": true, "data-source": "${data.banks}", "init-value": "${data.bank}"},
          {"type": "TextInput", "name": "branch", "label": "Branch", "input-type": "text", "required": true, "init-value": "${data.branch}"},
          {"type": "TextInput", "name": "account_number", "label": "Account number", "input-type": "text", "required": true, "init-value": "${data.account_number}"},
          {"type": "TextInput", "name": "account_name", "label": "Account name", "input-type": "text", "required": true, "init-value": "${data.account_name}"},
          {"type": "Dropdown", "name": "currency", "label": "Account currency", "required": true, "data-source": "${data.currencies}", "init-value": "${data.currency}"},
          {
            "type": "Footer",
            "label": "Save bank account",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {"bank": "${form.bank}", "branch": "${form.branch}", "account_number": "${form.account_number}", "account_name": "${form.account_name}", "currency": "${form.currency}"}
            }
          }
        ]
      }
    }
  ]
}
