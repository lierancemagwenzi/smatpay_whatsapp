{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "DETAILS": ["PASSWORD"],
    "PASSWORD": []
  },
  "screens": [
    {
      "id": "DETAILS",
      "title": "Your details",
      "data": {
        "first_name": {"type": "string", "__example__": "Tariro"},
        "last_name": {"type": "string", "__example__": "Moyo"},
        "email": {"type": "string", "__example__": "tariro@example.com"},
        "phone": {"type": "string", "__example__": "0771234567"},
        "has_error": {"type": "boolean", "__example__": false},
        "error_message": {"type": "string", "__example__": ""}
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {"type": "TextBody", "text": "${data.error_message}", "visible": "${data.has_error}"},
          {"type": "TextInput", "name": "first_name", "label": "First name", "input-type": "text", "required": true, "init-value": "${data.first_name}"},
          {"type": "TextInput", "name": "last_name", "label": "Last name", "input-type": "text", "required": true, "init-value": "${data.last_name}"},
          {"type": "TextInput", "name": "email", "label": "Email", "input-type": "email", "required": true, "init-value": "${data.email}", "helper-text": "We’ll send your activation code here"},
          {"type": "TextInput", "name": "phone", "label": "Mobile number", "input-type": "phone", "required": true, "init-value": "${data.phone}"},
          {
            "type": "Footer",
            "label": "Continue",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "first_name": "${form.first_name}",
                "last_name": "${form.last_name}",
                "email": "${form.email}",
                "phone": "${form.phone}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "PASSWORD",
      "title": "Choose a password",
      "terminal": true,
      "success": true,
      "data": {
        "email": {"type": "string", "__example__": "tariro@example.com"},
        "has_error": {"type": "boolean", "__example__": false},
        "error_message": {"type": "string", "__example__": ""}
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {"type": "TextBody", "text": "${data.error_message}", "visible": "${data.has_error}"},
          {"type": "TextBody", "text": "You’ll use this password with ${data.email} in the Smatpay app too."},
          {"type": "TextInput", "name": "password", "label": "Password", "input-type": "password", "required": true, "min-chars": 8, "helper-text": "At least 8 characters"},
          {"type": "TextInput", "name": "confirm_password", "label": "Confirm password", "input-type": "password", "required": true},
          {
            "type": "Footer",
            "label": "Create account",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "password": "${form.password}",
                "confirm_password": "${form.confirm_password}"
              }
            }
          }
        ]
      }
    }
  ]
}
